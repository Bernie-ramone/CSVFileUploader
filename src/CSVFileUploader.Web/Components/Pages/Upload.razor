@page "/upload"
@rendermode InteractiveServer

@using System.Security.Cryptography
@using CSVFileUploader.Application.Common.Models
@using CSVFileUploader.Application.CSV.UploadCsv
@using Microsoft.AspNetCore.Components.Forms
@using CSVFileUploader.Web.Components.Shared
@using CSVFileUploader.Web.Services

@inject CsvUploadOptions CsvUploadOptions
@inject IServiceScopeFactory ScopeFactory
@inject UiErrorHandler ErrorHandler

<PageTitle>CSV File Uploader</PageTitle>

<h1>CSV File Uploader</h1>

<div class="card">
    <div class="card-body">

        <div class="mb-3">
            <label class="form-label">
                Select CSV file
            </label>

            <InputFile OnChange="HandleFileSelected"
                       accept=".csv,text/csv" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_selectedFileName))
        {
            <div class="mb-3">
                <strong>Selected file:</strong>
                @_selectedFileName
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger">
                @_errorMessage
            </div>
        }

        <button type="button"
                class="btn btn-primary"
                disabled="@(!_canUpload || _isUploading)"
                @onclick="UploadAsync">

            @if (_isUploading)
            {
                <span class="spinner-border spinner-border-sm me-2"
                      aria-hidden="true">
                </span>

                <span>Uploading...</span>
            }
            else
            {
                <span>Upload</span>
            }
        </button>
    </div>
</div>

@if (_result is not null)
{
    <div class="row g-3">

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Total rows
                    </div>

                    <div class="fs-3 fw-bold">
                        @_result.TotalRows
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Inserted
                    </div>

                    <div class="fs-3 fw-bold text-success">
                        @_result.InsertedRows
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Duplicates
                    </div>

                    <div class="fs-3 fw-bold text-warning">
                        @_result.DuplicateRows
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">
                        Errors
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        @_result.Errors.Count
                    </div>
                </div>
            </div>
        </div>

        @if (_result.Errors.Count > 0)
        {
            <table class="csv-table">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Error</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var error in _result.Errors)
                    {
                        <tr class="table-danger">
                            <td>
                                @(error.RowNumber == 0
                                    ? "File"
                                    : error.RowNumber.ToString())
                            </td>

                            <td>
                                @error.Message
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </div>
}

@code {

    private IBrowserFile? _selectedFile;

    private string? _selectedFileName;

    private bool _isUploading;

    private string? _errorMessage;

    private bool _canUpload =>
        _selectedFile is not null &&
        !_isUploading;

    private UploadCsvResult? _result;

    private void HandleFileSelected(
        InputFileChangeEventArgs args)
    {
        _result = null;
        _errorMessage = null;

        _selectedFile = args.File;

        _selectedFileName = _selectedFile.Name;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _isUploading = true;
        _errorMessage = null;
        _result = null;

        try
        {
            var fileHash =
                await CalculateFileHashAsync(
                    _selectedFile);

            await using var fileStream =
                _selectedFile.OpenReadStream(
                    CsvUploadOptions.MaximumFileSizeInBytes);

            var command =
                new UploadCsvCommand(
                    FileStream: fileStream,
                    FileName: _selectedFile.Name,
                    ContentType: _selectedFile.ContentType,
                    FileSize: _selectedFile.Size,
                    FileHash: fileHash);

            using var scope =
                ScopeFactory.CreateScope();

            var handler =
                scope.ServiceProvider
                    .GetRequiredService<
                        UploadCsvCommandHandler>();

            _result =
                await handler.HandleAsync(
                    command);
        }
        catch (Exception ex)
        {
            _errorMessage =
                ErrorHandler.Handle(
                    ex,
                    "CSV file upload");
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task<string> CalculateFileHashAsync(
        IBrowserFile file)
    {
        await using var stream =
            file.OpenReadStream(
                CsvUploadOptions.MaximumFileSizeInBytes);

        using var sha256 =
            SHA256.Create();

        var hash =
            await sha256.ComputeHashAsync(
                stream);

        return Convert.ToHexString(hash);
    }
}