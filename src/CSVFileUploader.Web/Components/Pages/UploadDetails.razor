@page "/uploads/{UploadId:guid}"
@rendermode InteractiveServer

@using CSVFileUploader.Application.CSV.UploadHistory
@using CSVFileUploader.Application.DTOs.UploadHistory
@using CSVFileUploader.Web.Components.Shared
@using Microsoft.JSInterop
@using CSVFileUploader.Web.Services

@inject UiErrorHandler ErrorHandler
@inject IJSRuntime JS
@inject UploadIssuesCsvExporter IssuesCsvExporter

@inject IServiceScopeFactory ScopeFactory

<PageTitle>Upload Details</PageTitle>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}
else if (_isLoading)
{
    <div class="d-flex align-items-center gap-2"
         role="status">

        <div class="spinner-border spinner-border-sm"
             aria-hidden="true">
        </div>

        <span>
            Loading upload details...
        </span>
    </div>
}
else if (_upload is null)
{
    <div class="alert alert-warning">
        Upload was not found.
    </div>

    <a class="btn btn-secondary"
       href="/uploads">
        Back to history
    </a>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Upload Details</h1>

        <a class="btn btn-secondary"
           href="/uploads">
            Back to history
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-3">
                    File
                </dt>

                <dd class="col-sm-9">
                    @_upload.FileName
                </dd>

                <dt class="col-sm-3">
                    Uploaded
                </dt>

                <dd class="col-sm-9">
                    @_upload.UploadedAtUtc.ToLocalTime()
                </dd>

                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">
                   <UploadStatusBadge Status="@_upload.Status" />
                </dd>

                <dt class="col-sm-3">
                    Total rows
                </dt>

                <dd class="col-sm-9">
                    @_upload.TotalRows
                </dd>

                <dt class="col-sm-3">
                    Inserted
                </dt>

                <dd class="col-sm-9">
                    @_upload.InsertedRows
                </dd>

                <dt class="col-sm-3">
                    Duplicates
                </dt>

                <dd class="col-sm-9">
                    @_upload.DuplicateRows
                </dd>

                <dt class="col-sm-3">
                    Errors
                </dt>

                <dd class="col-sm-9">
                    @_upload.ErrorRows
                </dd>

            </dl>
        </div>
    </div>

    @if (_upload.Rows.Any(row => row.Status != CSVFileUploader.Domain.Enums.CsvUploadRowStatus.Imported))
    {
        <div class="mb-4">
            <button type="button"
                    class="btn btn-outline-danger"  @onclick="DownloadIssuesCsvAsync">

                Download Issues CSV
            </button>
        </div>
    }

    <h2 class="h4">
        Rows
    </h2>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Row</th>
                <th>Record</th>
                <th>Status</th>
                <th>Message</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var row in _upload.Rows)
            {
                <tr>
                    <td>@row.RowNumber</td>
                    <td>@row.RecordId</td>
                    <UploadRowStatusBadge Status="@row.Status" />
                    <td>@row.ErrorMessage</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Guid UploadId { get; set; }

    private UploadHistoryDetailDto? _upload;

    private bool _isLoading = true;

    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            using var scope =
                ScopeFactory.CreateScope();

            var handler =
                scope.ServiceProvider
                    .GetRequiredService<
                        GetUploadHistoryDetailsQueryHandler>();

            _upload =
                await handler.HandleAsync(
                    new GetUploadHistoryDetailsQuery(
                        UploadId));
        }
        catch (Exception ex)
        {
            _errorMessage =
                ErrorHandler.Handle(
                    ex,
                    "loading upload details");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DownloadIssuesCsvAsync()
    {
        if (_upload is null)
        {
            return;
        }

        var exporter =
            IssuesCsvExporter;

        var bytes =
            exporter.Export(_upload);

        var base64 =
            Convert.ToBase64String(bytes);

        var fileName =
            $"issues-{Path.GetFileNameWithoutExtension(
                _upload.FileName)}.csv";

        await JS.InvokeVoidAsync(
            "csvFileUploader.download",
            fileName,
            "text/csv;charset=utf-8",
            base64);
    }
}