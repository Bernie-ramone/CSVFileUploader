@page "/uploads"
@attribute [Authorize]
@rendermode InteractiveServer

@using CSVFileUploader.Application.CSV.UploadHistory
@using CSVFileUploader.Application.Common.Models
@using CSVFileUploader.Application.DTOs.UploadHistory
@using CSVFileUploader.Web.Services
@using Microsoft.AspNetCore.Authorization

@inject UiErrorHandler ErrorHandler
@inject IServiceScopeFactory ScopeFactory

<PageTitle>Upload History</PageTitle>

<h1>Upload History</h1>

@if (_isLoading)
{
    <div class="d-flex align-items-center gap-2"
         role="status">

        <div class="spinner-border spinner-border-sm"
             aria-hidden="true">
        </div>

        <span>
            Loading upload history...
        </span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}
else if (_result is null ||
         _result.Items.Count == 0)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h4">
                No uploads yet
            </h2>

            <p class="text-muted">
                Upload a CSV file to see its processing history here.
            </p>

            <a class="btn btn-primary"
               href="/upload">
                Upload CSV
            </a>
        </div>
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>File</th>
                <th>Status</th>
                <th>Total</th>
                <th>Inserted</th>
                <th>Duplicates</th>
                <th>Errors</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var upload in _result.Items)
            {
                <tr>
                    <td>
                        @upload.UploadedAtUtc.ToLocalTime()
                    </td>

                    <td>
                        @upload.FileName
                    </td>

                    <td>
                        <UploadStatusBadge
                            Status="@upload.Status" />
                    </td>

                    <td>
                        @upload.TotalRows
                    </td>

                    <td>
                        @upload.InsertedRows
                    </td>

                    <td>
                        @upload.DuplicateRows
                    </td>

                    <td>
                        @upload.ErrorRows
                    </td>

                    <td>
                        <a class="btn btn-sm btn-outline-primary"
                           href="@($"/uploads/{upload.Id}")">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-3">

        <div>
            Page @_result.PageNumber
            of @_result.TotalPages

            <span class="ms-2 text-muted">
                (@_result.TotalCount total uploads)
            </span>
        </div>

        <div>
            <button class="btn btn-outline-secondary me-2"
                    disabled="@(_result.PageNumber <= 1 || _isLoading)"
                    @onclick="PreviousPageAsync">
                Previous
            </button>

            <button class="btn btn-outline-primary"
                    disabled="@(_result.PageNumber >= _result.TotalPages || _isLoading)"
                    @onclick="NextPageAsync">
                Next
            </button>
        </div>
    </div>
}

@code {
    private const int PageSize = 20;

    private PagedResult<UploadHistoryItemDto>? _result;

    private bool _isLoading = true;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync(1);
    }

    private async Task PreviousPageAsync()
    {
        if (_result is null ||
            _result.PageNumber <= 1)
        {
            return;
        }

        await LoadPageAsync(
            _result.PageNumber - 1);
    }

    private async Task NextPageAsync()
    {
        if (_result is null ||
            _result.PageNumber >= _result.TotalPages)
        {
            return;
        }

        await LoadPageAsync(
            _result.PageNumber + 1);
    }

    private async Task LoadPageAsync(
        int pageNumber)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            using var scope =
                ScopeFactory.CreateScope();

            var handler =
                scope.ServiceProvider
                    .GetRequiredService<
                        GetUploadHistoryQueryHandler>();

            _result =
                await handler.HandleAsync(
                    new GetUploadHistoryQuery(
                        pageNumber,
                        PageSize));
        }
        catch (Exception ex)
        {
            _errorMessage =
                ErrorHandler.Handle(
                    ex,
                    "loading upload history");
        }
        finally
        {
            _isLoading = false;
        }
    }
}