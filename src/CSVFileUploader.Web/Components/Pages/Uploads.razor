@page "/uploads"
@rendermode InteractiveServer

@using CSVFileUploader.Application.CSV.UploadHistory
@using CSVFileUploader.Application.DTOs.UploadHistory

@inject IServiceScopeFactory ScopeFactory

<PageTitle>Upload History</PageTitle>

<h1>Upload History</h1>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}
else if (_uploads.Count == 0)
{
    <div class="alert alert-info">
        No uploads have been processed yet.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>File</th>
                <th>Status</th>
                <th>Total</th>
                <th>Inserted</th>
                <th>Duplicates</th>
                <th>Errors</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var upload in _uploads)
            {
                <tr>
                    <td>
                        @upload.UploadedAtUtc.ToLocalTime()
                    </td>

                    <td>
                        @upload.FileName
                    </td>

                    <td>
                        @GetStatusText(upload.Status)
                    </td>

                    <td>@upload.TotalRows</td>

                    <td>@upload.InsertedRows</td>

                    <td>@upload.DuplicateRows</td>

                    <td>@upload.ErrorRows</td>

                    <td>
                        <a class="btn btn-sm btn-outline-primary"
                           href="@($"/uploads/{upload.Id}")">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyCollection<UploadHistoryItemDto> _uploads = [];

    private bool _isLoading = true;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var scope =
                ScopeFactory.CreateScope();

            var handler =
                scope.ServiceProvider
                    .GetRequiredService<
                        GetUploadHistoryQueryHandler>();

            _uploads =
                await handler.HandleAsync(
                    new GetUploadHistoryQuery());
        }
        catch (Exception)
        {
            _errorMessage =
                "Unable to load upload history.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetStatusText(CSVFileUploader.Domain.Enums.CsvUploadStatus status)
    {
        return status switch
        {
            CSVFileUploader.Domain.Enums.CsvUploadStatus.Completed => "Completed",

            CSVFileUploader.Domain.Enums.CsvUploadStatus.CompletedWithErrors => "Completed with errors",

            CSVFileUploader.Domain.Enums.CsvUploadStatus.Processing => "Processing",

            CSVFileUploader.Domain.Enums.CsvUploadStatus.Failed => "Failed",

            _ => "Unknown"
        };
    }
}