@page "/uploadCsv"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using CSVFileUploader.Application.CSV.UploadCsv
@using CSVFileUploader.Application.Common.Models

@inject IServiceScopeFactory ScopeFactory

<PageTitle>CSV File Uploader</PageTitle>

<style>
    .csv-dialog {
        max-width: 560px;
        margin: 40px auto;
        background: #1c1e30;
        border-radius: 12px;
        padding: 24px;
        color: #e9e9ed;
        font-family: 'Inter', system-ui, sans-serif;
        box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }
    .csv-dialog h1 { font-size: 20px; font-weight: 500; margin: 0; }
    .csv-dialog .subtitle { font-size: 13px; color: #9a9aa6; margin-top: 2px; }
    .csv-hr { border: none; border-top: 1px solid #2b2e46; margin: 16px 0; }
    .csv-dropzone {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 8px; text-align: center; padding: 36px 20px; border-radius: 8px;
        border: 1px dashed #2b2e46; background: #20233a; cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
    }
    .csv-dropzone.dragging { border-color: #9184d9; background: rgba(145,132,217,0.12); }
    .csv-dropzone input[type=file] { display: none; }
    .csv-dropzone .choose { color: #c3b8ef; }
    .csv-dropzone .hint { font-size: 12px; color: #9a9aa6; }
    .csv-selected { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-top: 12px; color: #9a9aa6; }
    .csv-selected strong { color: #e9e9ed; font-weight: 500; }
    .csv-alert {
        margin-top: 12px; padding: 10px 12px; border-radius: 8px;
        background: rgba(145,132,217,0.12); border: 1px solid rgba(145,132,217,0.3);
        font-size: 13px; color: #c3b8ef;
    }
    .csv-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 20px; }
    .csv-btn { border-radius: 8px; padding: 8px 16px; font-size: 14px; font-weight: 500; cursor: pointer; border: 1px solid transparent; }
    .csv-btn-secondary { background: transparent; border-color: #2b2e46; color: #e9e9ed; }
    .csv-btn-primary { background: transparent; border-color: #9184d9; color: #9184d9; }
    .csv-btn-primary:disabled { opacity: 0.45; cursor: not-allowed; }
    .csv-result { margin-top: 20px; padding: 16px; border-radius: 8px; background: #20233a; }
    .csv-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .csv-stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #9a9aa6; }
    .csv-stat-value { font-size: 20px; margin-top: 2px; }
    .csv-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
    .csv-table th, .csv-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #2b2e46; }
    .csv-table th { color: #9a9aa6; font-weight: 500; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; }
</style>

<div class="csv-dialog">
    <h1>CSV File Uploader</h1>
    <div class="subtitle">Upload a CSV file to this project</div>
    <hr class="csv-hr" />

    <label class="csv-dropzone @(_isDragging ? "dragging" : "")" id="csvDropzone">
        <InputFile OnChange="HandleFileSelected" accept=".csv,text/csv" />
        <svg width="30" height="30" viewBox="0 0 256 256" fill="#9184d9">
            <path d="M240,136v64a16,16,0,0,1-16,16H32a16,16,0,0,1-16-16V136a8,8,0,0,1,16,0v64H224V136a8,8,0,0,1,16,0ZM93.66,101.66,120,75.31V168a8,8,0,0,0,16,0V75.31l26.34,26.35a8,8,0,0,0,11.32-11.32l-40-40a8,8,0,0,0-11.32,0l-40,40a8,8,0,0,0,11.32,11.32Z" />
        </svg>
        <div>Drag &amp; drop or <span class="choose">choose file</span></div>
        <div class="hint">CSV files only. File size max 10 MB.</div>
    </label>

    @if (!string.IsNullOrWhiteSpace(_selectedFileName))
    {
        <div class="csv-selected">
            <span>Selected:</span>
            <strong>@_selectedFileName</strong>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="csv-alert">@_errorMessage</div>
    }

    @if (_result is not null)
    {
        <div class="csv-result">
            <div class="csv-stats">
                <div>
                    <div class="csv-stat-label">Total rows</div>
                    <div class="csv-stat-value">@_result.TotalRows</div>
                </div>
                <div>
                    <div class="csv-stat-label">Inserted</div>
                    <div class="csv-stat-value" style="color:#9184d9">@_result.InsertedRows</div>
                </div>
                <div>
                    <div class="csv-stat-label">Duplicates</div>
                    <div class="csv-stat-value">@_result.DuplicateRows</div>
                </div>
                <div>
                    <div class="csv-stat-label">Errors</div>
                    <div class="csv-stat-value">@_result.Errors.Count</div>
                </div>
            </div>

            @if (_result.Errors.Count > 0)
            {
                <table class="csv-table">
                    <thead><tr><th>Row</th><th>Error</th></tr></thead>
                    <tbody>
                        @foreach (var error in _result.Errors)
                        {
                            <tr>
                                <td>@(error.RowNumber == 0 ? "File" : error.RowNumber.ToString())</td>
                                <td>@error.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <div class="csv-actions">
        <button type="button" class="csv-btn csv-btn-secondary" @onclick="Cancel">Cancel</button>
        <button type="button" class="csv-btn csv-btn-primary" disabled="@(!_canUpload || _isUploading)" @onclick="UploadAsync">
            @(_isUploading ? "Uploading…" : "Upload")
        </button>
    </div>
</div>

<script>
    (function() {
        const zone = document.getElementById('csvDropzone');
        if (!zone) return;
        ['dragover', 'dragenter'].forEach(evt =>
            zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.add('dragging'); }));
        ['dragleave', 'drop'].forEach(evt =>
            zone.addEventListener(evt, e => { e.preventDefault(); zone.classList.remove('dragging'); }));
        zone.addEventListener('drop', e => {
            const input = zone.querySelector('input[type=file]');
            if (input && e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                input.dispatchEvent(new Event('change', { bubbles: true }));
            }
        });
    })();
</script>

@code {
    private const long MaxFileSize = 10 * 1024 * 1024;

    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private bool _isUploading;
    private bool _isDragging;
    private string? _errorMessage;
    private UploadCsvResult? _result;

    private bool _canUpload =>
        _selectedFile is not null &&
        !_isUploading;

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        _result = null;
        _errorMessage = null;
        _selectedFile = args.File;
        _selectedFileName = _selectedFile.Name;
    }

    private void Cancel()
    {
        _selectedFile = null;
        _selectedFileName = null;
        _errorMessage = null;
        _result = null;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _isUploading = true;
        _errorMessage = null;
        _result = null;

        try
        {
            await using var fileStream = _selectedFile.OpenReadStream(MaxFileSize);

            var command = new UploadCsvCommand(
                FileStream: fileStream,
                FileName: _selectedFile.Name,
                ContentType: _selectedFile.ContentType,
                FileSize: _selectedFile.Size);

            using var scope = ScopeFactory.CreateScope();

            var handler = scope.ServiceProvider
                .GetRequiredService<UploadCsvCommandHandler>();

            _result = await handler.HandleAsync(command);
        }
        catch (IOException ex)
        {
            _errorMessage = $"The file could not be read: {ex.Message}";
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred while processing the file.";
        }
        finally
        {
            _isUploading = false;
        }
    }
}